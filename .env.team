DOTENV_PUBLIC_KEY_TEAM="03d94dd99efcf2d094f6cb3fae4da92c432f49cb91a7c40e98b7e90cf252e0725a"

# .env.team: shared team secrets, encrypted. Safe to commit; unreadable without the decryption key.
# Decrypt: put DOTENV_PRIVATE_KEY_TEAM in a git-ignored .env.keys file (ask Pulkit in a private DM).
# Add or change a secret (encrypts automatically):  npm run secret:set -- JWT_SECRET "value"
# Read one:                                         npm run secret:get -- JWT_SECRET
# Names the app reads: GEMINI_API_KEY, GEMINI_MODEL (dev server); DATABASE_URL, JWT_SECRET,
#   RESEARCHER_REGISTRATION_KEY (npm run api). Any VITE_ value is passed to the browser.
# VITE_ values are shipped to the browser: use that prefix only for publishable values, never for a
#   database URL, password, or JWT secret.
