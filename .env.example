# Optional local model. Ollama must already be running on this computer.
VITE_OLLAMA_MODEL=llama3.2:3b
VITE_OLLAMA_BASE=/ollama

# Optional Aetheria Guide (Gemini free tier). Copy this file to .env.local and paste your key.
# The key is read by the dev server only and is never sent to the browser.
# Free-tier prompts may be used by Google to improve its products.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Supabase browser configuration.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
